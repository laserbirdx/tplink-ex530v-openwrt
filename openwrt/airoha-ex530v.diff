diff --git a/target/linux/airoha/image/en7523.mk b/target/linux/airoha/image/en7523.mk
index ad056ee..d0f15f9 100644
--- a/target/linux/airoha/image/en7523.mk
+++ b/target/linux/airoha/image/en7523.mk
@@ -143,14 +143,39 @@ define Device/skyworth_gn630v
 endef
 TARGET_DEVICES += skyworth_gn630v
 
+# TP-Link vendor U-Boot ("flash tpimg") image for the raw slot B kernel
+# partition: 0x200 byte header, LE magic 0x03000003 at 0x0 and LE payload (FIT)
+# size at 0x78; nothing else is checked. Then "bootm 81800200" boots the FIT.
+define Build/ex530v-tp-header
+	perl -e 'my $$n = -s $$ARGV[0]; print pack("V", 0x03000003), "\0" x 0x74, pack("V", $$n), "\0" x (0x200 - 0x7c)' $@ > $@.new
+	cat $@ >> $@.new
+	mv $@.new $@
+endef
+
+# Stock layout is kept: OpenWrt goes into the empty vendor slot B. The kernel
+# (TP header + FIT) is written raw into the "kernel" partition (0x2cc0000),
+# root squashfs + rootfs_data live in the "ubi" partition. sysupgrade.bin is a
+# standard OpenWrt NAND tar (kernel + root) handled by nand_do_upgrade.
 define Device/tplink_ex530v-v1
-  $(Device/Uboot-FitImage)
   DEVICE_VENDOR := TP-Link
   DEVICE_MODEL := ex530v
   DEVICE_VARIANT := v1
+  KERNEL_LOADADDR := 0x80088000
+  KERNEL_NAME := Image
+  BLOCKSIZE := 256k
+  PAGESIZE := 4096
+  KERNEL_SIZE := 8192k
+  KERNEL := kernel-bin | lzma | \
+    fit lzma $$(KDIR)/image-$$(DEVICE_DTS).dtb | ex530v-tp-header
+  KERNEL_INITRAMFS := kernel-bin | lzma | \
+    fit lzma $$(KDIR)/image-$$(DEVICE_DTS).dtb with-initrd | pad-to 128k
+  IMAGES := sysupgrade.bin slotb-kernel.bin rootfs.squashfs
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+  IMAGE/slotb-kernel.bin := append-kernel | check-size $$$$(KERNEL_SIZE)
+  IMAGE/rootfs.squashfs := append-rootfs
   DEVICE_PACKAGES += kmod-usb-ohci kmod-usb3 \
                      hostapd-mbedtls wpa-supplicant-mbedtls \
-                     kmod-mt7915e kmod-mt7916-firmware  airoha-en7523-kite-npu-firmware
+                     kmod-mt7915e kmod-mt7916-firmware
 endef
 TARGET_DEVICES += tplink_ex530v-v1
 
diff --git a/target/linux/airoha/patches-6.18/999-arm-airoha-en7523-text-offset-above-atf.patch b/target/linux/airoha/patches-6.18/999-arm-airoha-en7523-text-offset-above-atf.patch
new file mode 100644
index 0000000..ce4ca11
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/999-arm-airoha-en7523-text-offset-above-atf.patch
@@ -0,0 +1,29 @@
+From: Mehmet Salih <salihmehmet497@gmail.com>
+Subject: ARM: airoha: link the kernel 0x88000 into DRAM to keep clear of ATF
+
+On EN7523 boards the vendor boot chain (BL2 -> BL32/sp_min -> U-Boot) leaves
+the AArch32 Trusted Firmware runtime resident at the very start of DRAM
+(vendor DT: atf-reserved-memory@80000000, 0x40000 bytes, no-map). With the
+default TEXT_OFFSET of 0x8000 the raw kernel Image lands at 0x80008000 and
+overwrites it, so the first PSCI SMC ("psci: probing for conduit method
+from DT") jumps into kernel text and the boot locks up hard -- which is
+exactly what was observed on the Zyxel EX3501-T0 and mis-diagnosed as
+"this U-Boot has no PSCI conduit". The vendor kernel is linked at
+PAGE_OFFSET + 0x88000 (virt 0xC0088000, phys 0x80088000) for this reason.
+
+Use the same text offset for ARCH_AIROHA so head.S still derives
+PHYS_OFFSET = 0x80000000 from the 0x80088000 load address, and the EL3
+runtime survives. Pair with KERNEL_LOADADDR := 0x80088000 in the image
+recipe and re-enable the psci node / cpu enable-method in the board DT.
+
+--- a/arch/arm/Makefile
++++ b/arch/arm/Makefile
+@@ -160,6 +160,8 @@
+ # during boot, and this offset is critical to the functioning of
+ # kexec-tools.
+ textofs-y	:= 0x00008000
++# Airoha EN7523: keep the kernel above the resident AArch32 TF-A (sp_min)
++textofs-$(CONFIG_ARCH_AIROHA) := 0x00088000
+ # RTD1195 has Boot ROM at start of address space
+ textofs-$(CONFIG_ARCH_REALTEK)  := 0x00108000
+ # SA1111 DMA bug: we don't want the kernel to live in precious DMA-able memory
diff --git a/target/linux/airoha/patches-6.18/9991-net-airoha-en7523-wifi-fastpath.patch b/target/linux/airoha/patches-6.18/9991-net-airoha-en7523-wifi-fastpath.patch
new file mode 100644
index 0000000..aeae767
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/9991-net-airoha-en7523-wifi-fastpath.patch
@@ -0,0 +1,374 @@
+From: EX530v bring-up
+Subject: [PATCH] net: airoha: en7523: PPE fast path towards WiFi
+
+Bind flows towards wireless netdevs with PSE port CDM1 and hand the
+bound frames (CPU reason 0x16) to the L2 egress device (the bridge of the
+AP, or the AP itself), found by the source MAC the PPE wrote into them.
+Frames spanning several RX buffers and hardware-LRO aggregates are
+reassembled like on the normal RX path.
+
+diff -urN orig/drivers/net/ethernet/airoha/airoha_eth.c mac/drivers/net/ethernet/airoha/airoha_eth.c
+--- a/drivers/net/ethernet/airoha/airoha_eth.c	2026-11-23 20:22:15.152260926 +0300
++++ b/drivers/net/ethernet/airoha/airoha_eth.c	2026-11-23 23:52:14.267476677 +0300
+@@ -2436,6 +2436,170 @@
+ 	return frame_desc;
+ }
+ 
++/* EN7523 WiFi fast path counters (read-only parameters) */
++static unsigned long en7523_wifi_fp_xmit;
++module_param(en7523_wifi_fp_xmit, ulong, 0444);
++MODULE_PARM_DESC(en7523_wifi_fp_xmit, "EN7523: bound frames handed to WiFi");
++static unsigned long en7523_wifi_fp_multi;
++module_param(en7523_wifi_fp_multi, ulong, 0444);
++MODULE_PARM_DESC(en7523_wifi_fp_multi,
++		 "EN7523: of these, frames that spanned several RX buffers");
++static unsigned long en7523_wifi_fp_lro;
++module_param(en7523_wifi_fp_lro, ulong, 0444);
++MODULE_PARM_DESC(en7523_wifi_fp_lro,
++		 "EN7523: of these, hardware-LRO aggregated frames");
++static unsigned long en7523_wifi_fp_nomatch;
++module_param(en7523_wifi_fp_nomatch, ulong, 0444);
++MODULE_PARM_DESC(en7523_wifi_fp_nomatch,
++		 "EN7523: bound frames to CPU with no matching WiFi device");
++static unsigned long en7523_wifi_fp_drop;
++module_param(en7523_wifi_fp_drop, ulong, 0444);
++MODULE_PARM_DESC(en7523_wifi_fp_drop,
++		 "EN7523: fast path frames dropped (no memory, too many frags, device gone)");
++
++static void airoha_en7523_fp_xmit(struct airoha_queue *q, struct sk_buff *skb)
++{
++	struct net_device *odev;
++
++	odev = dev_get_by_index_rcu(&init_net, q->fp_ifindex);
++	q->fp_ifindex = 0;
++	if (!odev || !netif_running(odev)) {
++		en7523_wifi_fp_drop++;
++		dev_kfree_skb(skb);
++		return;
++	}
++
++	skb->dev = odev;
++	en7523_wifi_fp_xmit++;
++	dev_queue_xmit(skb);
++}
++
++/* EN7523 WiFi fast path: flows bound towards a wireless device (see
++ * airoha_ppe_foe_entry_prepare()) reach the CPU through CDM1 with PPE reason
++ * 0x16 (hit bind, to CPU), already NATed, VLAN/PPPoE-stripped and
++ * L2-rewritten: the source MAC is the address of the L2 egress device (the
++ * AP's bridge). They carry no GDM source port, so this runs before the
++ * source-port lookup. Hand them straight to that device, skipping GRO,
++ * routing and netfilter. Full-size frames arrive split over several RX
++ * buffers (MORE flag) and are reassembled here like the normal path does.
++ *
++ * Returns 1 when a frame was completed (sent or dropped), 0 when the buffer
++ * was consumed as part of a frame that continues, -1 when the buffer is not
++ * ours and must take the normal path.
++ */
++static int airoha_en7523_rx_fastpath(struct airoha_queue *q,
++				     struct airoha_qdma_desc *desc,
++				     struct airoha_queue_entry *e, u32 len,
++				     bool more)
++{
++	struct airoha_eth *eth = q->qdma->eth;
++	u32 msg1 = le32_to_cpu(READ_ONCE(desc->msg1));
++	u32 reason = FIELD_GET(EN7523_QDMA_ETH_RXMSG_CRSN_MASK, msg1);
++	u32 hash = FIELD_GET(EN7523_QDMA_ETH_RXMSG_PPE_ENTRY_MASK, msg1);
++	u32 agg = FIELD_GET(QDMA_ETH_RXMSG_AGG_COUNT_MASK,
++			    le32_to_cpu(READ_ONCE(desc->msg2)));
++	const struct ethhdr *eh = e->buf;
++	struct net_device *odev;
++	struct sk_buff *skb;
++	int ret = 1;
++
++	rcu_read_lock();
++
++	if (q->skb) {
++		/* continuation buffer of a scattered frame */
++		struct page *page = virt_to_head_page(e->buf);
++		struct skb_shared_info *shinfo;
++
++		if (!q->fp_ifindex) {
++			ret = -1;	/* the normal path owns q->skb */
++			goto out;
++		}
++
++		shinfo = skb_shinfo(q->skb);
++		if (shinfo->nr_frags >= ARRAY_SIZE(shinfo->frags)) {
++			en7523_wifi_fp_drop++;
++			dev_kfree_skb(q->skb);
++			q->skb = NULL;
++			q->fp_ifindex = 0;
++			page_pool_put_full_page(q->page_pool, page, true);
++			ret = more ? 0 : 1;
++			goto out;
++		}
++
++		skb_add_rx_frag(q->skb, shinfo->nr_frags, page,
++				e->buf - page_address(page), len,
++				q->buf_size);
++		if (more) {
++			ret = 0;
++			goto out;
++		}
++
++		skb = q->skb;
++		q->skb = NULL;
++		en7523_wifi_fp_multi++;
++		airoha_en7523_fp_xmit(q, skb);
++		goto out;
++	}
++
++	/* first (or only) buffer of a frame */
++	q->fp_ifindex = 0;
++	if (!en7523_wifi_fastpath || reason != CRSN_22 || len < ETH_HLEN) {
