diff --git a/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh b/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh
index 7b4db5e..0c39a73 100644
--- a/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh
+++ b/target/linux/airoha/en7523/base-files/lib/upgrade/platform.sh
@@ -70,10 +70,87 @@ platform_do_upgrade_mikrotik_nand() {
 	nand_do_upgrade "$image"
 }
 
+# Vendor U-Boot ("flash tpimg") picks the slot from 8 bytes at the start of
+# the "reserve" partition: image1 (slot B) when bytes 4 and 5 are non-zero,
+# byte 7 = sum of bytes 0..6. Erased or invalid -> image0 (stock, slot A).
+# Same as "flash bflag 1" at the U-Boot prompt. Only called after the new
+# firmware has been written successfully.
+ex530v_bootflag_is_b() {
+  local dev="$1" b sum=0 i=0 b4 b5 b7
+
+  for b in $(dd if="$dev" bs=8 count=1 2>/dev/null | hexdump -v -e '8/1 "%u "'); do
+    [ $i -lt 7 ] && sum=$((sum + b))
+    [ $i -eq 4 ] && b4=$b
+    [ $i -eq 5 ] && b5=$b
+    [ $i -eq 7 ] && b7=$b
+    i=$((i + 1))
+  done
+  [ "$i" -eq 8 ] && [ "$b4" -ne 0 ] && [ "$b5" -ne 0 ] && [ $((sum & 255)) -eq "$b7" ]
+}
+
+ex530v_set_bootflag() {
+  local mtdnum="$(find_mtd_index reserve)"
+  local dev="/dev/mtd$mtdnum" img=/tmp/ex530v-bootflag.bin
+
+  [ -n "$mtdnum" ] || {
+    echo "cannot find reserve partition, boot flag not set"
+    return 1
+  }
+  ex530v_bootflag_is_b "$dev" && return 0
+
+  echo "setting vendor boot flag to slot B (image1)"
+  # keep the rest of the 256 KiB block as it is
+  {
+    printf '\000\000\000\001\001\001\000\003'
+    dd if="$dev" bs=8 skip=1 count=511 2>/dev/null
+    dd if="$dev" bs=4096 skip=1 count=63 2>/dev/null
+  } > "$img"
+  mtd write "$img" reserve && ex530v_bootflag_is_b "$dev" || {
+    echo "WARNING: boot flag not set, run 'flash bflag 1' in U-Boot"
+    return 1
+  }
+}
+
+# First install: the "ubi" area is erased flash on a stock unit. UBI attaches
+# empty flash without writing EC headers to every PEB, which leaves PEB 0 blank,
+# and the kernel's UBI auto-attach (it checks for "UBI#" at the start of the
+# partition) then never attaches it -> no root fs. Format it properly first.
+ex530v_format_ubi() {
+  local mtdnum="$(find_mtd_index ubi)"
+
+  [ -n "$mtdnum" ] || {
+    echo "cannot find ubi partition"
+    return 1
+  }
+  # look at the flash, not at the attach state: an attached UBI on flash that
+  # was erased behind its back must be re-formatted too
+  [ "$(dd if=/dev/mtd$mtdnum bs=4 count=1 2>/dev/null)" = "UBI#" ] && return 0
+
+  echo "ubi partition is not UBI formatted, running ubiformat"
+  if [ -n "$(nand_find_ubi ubi)" ]; then
+    ubidetach -m "$mtdnum" || {
+      echo "cannot detach ubi partition"
+      return 1
+    }
+  fi
+  ubiformat /dev/mtd$mtdnum -y -q
+}
+
 platform_do_upgrade() {
   local board=$(board_name)
 
   case "$board" in
+  tplink,ex530v-v1)
+    # raw kernel in "kernel" (vendor slot B), squashfs + rootfs_data in "ubi"
+    CI_KERNPART=kernel
+    CI_UBIPART=ubi
+    CI_ROOTPART=rootfs
+    ex530v_format_ubi || return 1
+    sync
+    nand_do_flash_file "$1" || nand_do_upgrade_failed
+    ex530v_set_bootflag
+    nand_do_upgrade_success
+    ;;
   askey,rtf8225vw |\
   genexis,arcee |\
   genexis,e650 |\
@@ -82,7 +159,6 @@ platform_do_upgrade() {
   genexis,rodimus_r1 |\
   genexis,zephyr |\
   mitrastar,gpt-2742gx4x5v6 |\
-  tplink,ex530v-v1 |\
   tplink,xx230v-v1)
     fit_do_upgrade "$1"
     ;;
@@ -98,11 +174,37 @@ platform_do_upgrade() {
   sync
 }
 
+ex530v_check_image() {
+  local file="$1"
+  local board_dir magic
+
+  nand_do_platform_check "tplink,ex530v-v1" "$file" || return 1
+
+  board_dir="$(tar tf "$file" | grep -m 1 '^sysupgrade-.*/$')"
+  board_dir="${board_dir%/}"
+  [ -n "$board_dir" ] || {
+    echo "Not a NAND sysupgrade tar"
+    return 1
+  }
+
+  # vendor U-Boot ("flash tpimg") only boots slot B with this header magic
+  magic="$(tar xOf "$file" "$board_dir/kernel" 2>/dev/null | head -c 4 | hexdump -v -e '1/1 "%02x"')"
+  [ "$magic" = "03000003" ] || {
+    echo "Kernel has no TP-Link slot header (magic '$magic'), refusing"
+    return 1
+  }
+  return 0
+}
+
 platform_check_image() {
   local board=$(board_name)
   [ "$#" -gt 1 ] && return 1
 
   case "$board" in
+  tplink,ex530v-v1)
+    ex530v_check_image "$1"
+    return $?
+    ;;
   askey,rtf8225vw |\
   genexis,arcee |\
   genexis,e650 |\
@@ -111,7 +213,6 @@ platform_check_image() {
   genexis,rodimus_r1 |\
   genexis,zephyr |\
   mitrastar,gpt-2742gx4x5v6 |\
-  tplink,ex530v-v1 |\
   tplink,xx230v-v1)
     fit_check_image "$1"
     return $?
