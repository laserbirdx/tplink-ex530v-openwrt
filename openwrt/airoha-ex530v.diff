++/* EN7523 WHNAT FOE layout, from the stock hw_nat.ko (PpeSetPortInfo with the
++ * WHNAT magic 0x7615, as filled by mt_whnat.ko wifi_tx_tuple_add()):
++ *   ring = band | wdma_idx << 1
