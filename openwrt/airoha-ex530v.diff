diff --git a/target/linux/airoha/image/en7523.mk b/target/linux/airoha/image/en7523.mk
index ad056ee..d0f15f9 100644
--- a/target/linux/airoha/image/en7523.mk
+++ b/target/linux/airoha/image/en7523.mk
@@ -143,14 +143,39 @@ define Device/skyworth_gn630v
 endef
 TARGET_DEVICES += skyworth_gn630v
 
+# TP-Link vendor U-Boot ("flash tpimg") image for the raw slot B kernel
+# partition: 0x200 byte header, LE magic 0x03000003 at 0x0 and LE payload (FIT)
+# size at 0x78; nothing else is checked. Then "bootm 81800200" boots the FIT.
+define Build/ex530v-tp-header
+	perl -e 'my $$n = -s $$ARGV[0]; print pack("V", 0x03000003), "\0" x 0x74, pack("V", $$n), "\0" x (0x200 - 0x7c)' $@ > $@.new
+	cat $@ >> $@.new
+	mv $@.new $@
+endef
+
+# Stock layout is kept: OpenWrt goes into the empty vendor slot B. The kernel
+# (TP header + FIT) is written raw into the "kernel" partition (0x2cc0000),
+# root squashfs + rootfs_data live in the "ubi" partition. sysupgrade.bin is a
+# standard OpenWrt NAND tar (kernel + root) handled by nand_do_upgrade.
 define Device/tplink_ex530v-v1
-  $(Device/Uboot-FitImage)
   DEVICE_VENDOR := TP-Link
   DEVICE_MODEL := ex530v
   DEVICE_VARIANT := v1
+  KERNEL_LOADADDR := 0x80088000
+  KERNEL_NAME := Image
+  BLOCKSIZE := 256k
+  PAGESIZE := 4096
+  KERNEL_SIZE := 8192k
+  KERNEL := kernel-bin | lzma | \
+    fit lzma $$(KDIR)/image-$$(DEVICE_DTS).dtb | ex530v-tp-header
+  KERNEL_INITRAMFS := kernel-bin | lzma | \
+    fit lzma $$(KDIR)/image-$$(DEVICE_DTS).dtb with-initrd | pad-to 128k
+  IMAGES := sysupgrade.bin slotb-kernel.bin rootfs.squashfs
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+  IMAGE/slotb-kernel.bin := append-kernel | check-size $$$$(KERNEL_SIZE)
+  IMAGE/rootfs.squashfs := append-rootfs
   DEVICE_PACKAGES += kmod-usb-ohci kmod-usb3 \
                      hostapd-mbedtls wpa-supplicant-mbedtls \
-                     kmod-mt7915e kmod-mt7916-firmware  airoha-en7523-kite-npu-firmware
+                     kmod-mt7915e kmod-mt7916-firmware
 endef
 TARGET_DEVICES += tplink_ex530v-v1
 
diff --git a/target/linux/airoha/patches-6.18/999-arm-airoha-en7523-text-offset-above-atf.patch b/target/linux/airoha/patches-6.18/999-arm-airoha-en7523-text-offset-above-atf.patch
new file mode 100644
index 0000000..ce4ca11
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/999-arm-airoha-en7523-text-offset-above-atf.patch
@@ -0,0 +1,29 @@
+From: Mehmet Salih <salihmehmet497@gmail.com>
+Subject: ARM: airoha: link the kernel 0x88000 into DRAM to keep clear of ATF
+
+On EN7523 boards the vendor boot chain (BL2 -> BL32/sp_min -> U-Boot) leaves
+the AArch32 Trusted Firmware runtime resident at the very start of DRAM
+(vendor DT: atf-reserved-memory@80000000, 0x40000 bytes, no-map). With the
+default TEXT_OFFSET of 0x8000 the raw kernel Image lands at 0x80008000 and
+overwrites it, so the first PSCI SMC ("psci: probing for conduit method
+from DT") jumps into kernel text and the boot locks up hard -- which is
+exactly what was observed on the Zyxel EX3501-T0 and mis-diagnosed as
+"this U-Boot has no PSCI conduit". The vendor kernel is linked at
+PAGE_OFFSET + 0x88000 (virt 0xC0088000, phys 0x80088000) for this reason.
+
+Use the same text offset for ARCH_AIROHA so head.S still derives
+PHYS_OFFSET = 0x80000000 from the 0x80088000 load address, and the EL3
+runtime survives. Pair with KERNEL_LOADADDR := 0x80088000 in the image
+recipe and re-enable the psci node / cpu enable-method in the board DT.
+
+--- a/arch/arm/Makefile
++++ b/arch/arm/Makefile
+@@ -160,6 +160,8 @@
+ # during boot, and this offset is critical to the functioning of
+ # kexec-tools.
+ textofs-y	:= 0x00008000
++# Airoha EN7523: keep the kernel above the resident AArch32 TF-A (sp_min)
++textofs-$(CONFIG_ARCH_AIROHA) := 0x00088000
+ # RTD1195 has Boot ROM at start of address space
+ textofs-$(CONFIG_ARCH_REALTEK)  := 0x00108000
+ # SA1111 DMA bug: we don't want the kernel to live in precious DMA-able memory
