+From: EX530v bring-up
+Subject: [PATCH] net: airoha: wed: fix EN7523 WPDMA base and mt76 TXD size
+
+- EN7523 WED1 must reach the MT7916 main function at 0x22000000 (pcie1
+  window), not 0x20100000 (inside pcie0's window).
+- Accept the TXD size returned by the WLAN driver (76 for mt76
+  mt7915/mt7916) instead of requiring the vendor driver's 128.
+
+diff -urN a/drivers/net/ethernet/airoha/airoha_wed.c b/drivers/net/ethernet/airoha/airoha_wed.c
+--- a/drivers/net/ethernet/airoha/airoha_wed.c	2026-11-24 00:25:37.848953081 +0300
++++ b/drivers/net/ethernet/airoha/airoha_wed.c	2026-11-24 00:25:37.849953103 +0300
+@@ -94,9 +94,15 @@
+ 	.set_lan_arb = true,
+ };
+ 
++/* EN7523: each PCIe port has its own 32 MiB window (pcie0 0x20000000,
++ * pcie1 0x22000000) and WED reaches the Wi-Fi WPDMA at the CPU physical BAR
++ * address. The EN751221 values ({0x20000000, 0x20100000}) pointed WED1 into
++ * pcie0's window (BAR2 of the MT7916 HIF2 function) instead of the MT7916
++ * main function at 0x22000000.
++ */
+ static const struct airoha_wed_soc_data en7523_wed_data = {
+ 	.pcie_base = { 0x1fa91000, 0x1fa92000 },
+-	.wpdma_base = { 0x20000000, 0x20100000 },
++	.wpdma_base = { 0x20000000, 0x22000000 },
+ };
+ 
+ static const struct of_device_id airoha_wed_of_match[] = {
+@@ -480,13 +486,19 @@
+ 			u32 txd_size, ctrl;
+ 
+ 			desc->buf0 = cpu_to_le32(buf_phys);
++			/* The vendor mt7916_ap driver uses a 128 byte
++			 * TXD+TXP; mt76 returns its own size (76 for
++			 * mt7915/mt7916). Use what the WLAN driver returns,
++			 * like upstream mtk_wed does.
++			 */
+ 			txd_size = dev->wlan.init_buf(buf, buf_phys, token++);
+-			if (WARN_ON_ONCE(txd_size != MTK_WED_TXD_SIZE))
++			if (WARN_ON_ONCE(!txd_size ||
++					 txd_size > MTK_WED_TXD_SIZE))
+ 				return -EINVAL;
+ 
+-			desc->buf1 = cpu_to_le32(buf_phys + MTK_WED_TXD_SIZE);
++			desc->buf1 = cpu_to_le32(buf_phys + txd_size);
+ 			ctrl = FIELD_PREP(MTK_WDMA_DESC_CTRL_LEN0,
+-					  MTK_WED_TXD_SIZE) |
++					  txd_size) |
+ 			       AIROHA_WDMA_DESC_CTRL_LAST_SEG1 |
+ 			       FIELD_PREP(MTK_WDMA_DESC_CTRL_LEN1_V2,
+ 					  MTK_WED_PKT_SIZE);
