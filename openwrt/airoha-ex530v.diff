diff --git a/package/kernel/mac80211/patches/subsys/423-mac80211-fill-forward-path-for-AP-without-hardware-path.patch b/package/kernel/mac80211/patches/subsys/423-mac80211-fill-forward-path-for-AP-without-hardware-path.patch
new file mode 100644
index 0000000..d22e28a
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/423-mac80211-fill-forward-path-for-AP-without-hardware-path.patch
@@ -0,0 +1,45 @@
+From: EX530v bring-up
+Subject: [PATCH] wifi: mac80211: resolve forward path for AP stations without a hardware path
+
+Adapted from the EX3501-T0 399 patch: also fall back when the driver hook
+exists but returns an error (mt76 with WED compiled in but inactive).
+
+--- a/net/mac80211/iface.c
++++ b/net/mac80211/iface.c
+@@ -1005,7 +1005,9 @@
+ 	sdata = IEEE80211_DEV_TO_SUB_IF(ctx->dev);
+ 	local = sdata->local;
+ 
+-	if (!local->ops->net_fill_forward_path)
++	if (!local->ops->net_fill_forward_path &&
++	    sdata->vif.type != NL80211_IFTYPE_AP &&
++	    sdata->vif.type != NL80211_IFTYPE_AP_VLAN)
+ 		return -EOPNOTSUPP;
+ 
+ 	rcu_read_lock();
+@@ -1045,7 +1047,24 @@
+ 	if (!sta)
+ 		goto out;
+ 
+-	ret = drv_net_fill_forward_path(local, sdata, &sta->sta, ctx, path);
++	ret = -EOPNOTSUPP;
++	if (local->ops->net_fill_forward_path)
++		ret = drv_net_fill_forward_path(local, sdata, &sta->sta, ctx,
++						path);
++
++	/* No hardware (WED) path, e.g. MT7916 on Airoha EN7523: end the
++	 * forward path at this AP interface as a plain Ethernet device so
++	 * that flowtables (and the EN7523 PPE fast path) can transmit flows
++	 * straight to it instead of falling back to the bridge/neighbour path.
++	 */
++	if (ret && (sdata->vif.type == NL80211_IFTYPE_AP ||
++		    sdata->vif.type == NL80211_IFTYPE_AP_VLAN) &&
++	    test_sta_flag(sta, WLAN_STA_AUTHORIZED)) {
++		path->type = DEV_PATH_ETHERNET;
++		path->dev = ctx->dev;
++		ctx->dev = NULL;
++		ret = 0;
++	}
+ out:
+ 	rcu_read_unlock();
+ 
