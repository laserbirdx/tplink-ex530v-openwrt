+ 				       TX_COHERENT_HIGH_INT_MASK);
+@@ -3640,6 +3663,8 @@
+ 		for (i = 0; i < ARRAY_SIZE(qdma->q_tx_irq); i++) {
+ 			if (!(intr[0] & TX_DONE_INT_MASK(i)))
