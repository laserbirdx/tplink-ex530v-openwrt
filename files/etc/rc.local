# EX530v first-boot defaults (open SSIDs, 5G HE160, HW flow offload).
# Applied ONCE: the marker lives on the persistent overlay, so later changes
# made in LuCI/uci are kept. Delete /etc/ex530v-defaults-applied to re-apply.
# Runs after wifi detection, so /etc/config/wireless already exists.
M=/etc/ex530v-defaults-applied
[ -e "$M" ] || (
	sleep 5
	uci -q batch <<-EOT
		set wireless.radio0.country='TR'
		set wireless.radio1.country='TR'
		set wireless.radio0.disabled='0'
		set wireless.radio0.htmode='HE40'
		set wireless.radio0.noscan='1'
		set wireless.radio1.disabled='0'
		set wireless.radio1.channel='36'
		set wireless.radio1.htmode='HE160'
		set wireless.default_radio0.ssid='EX530v-OpenWrt-2G'
		set wireless.default_radio0.encryption='none'
		delete wireless.default_radio0.key
		delete wireless.default_radio0.disabled
		set wireless.default_radio1.ssid='EX530v-OpenWrt-5G'
		set wireless.default_radio1.encryption='none'
		delete wireless.default_radio1.key
		delete wireless.default_radio1.disabled
		set firewall.@defaults[0].flow_offloading='1'
		set firewall.@defaults[0].flow_offloading_hw='1'
		commit wireless
		commit firewall
	EOT
	wifi reload
	/etc/init.d/firewall reload
	touch "$M"
	logger -t ex530v "applied first-boot defaults (open SSIDs, hw flow offload)"
) &

exit 0
